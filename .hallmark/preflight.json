{
  "date": "2026-07-25",
  "designSystem": {
    "file": "DESIGN.md",
    "managed": true,
    "note": "Progetto system-managed: la diversificazione e' INVERTITA (le pagine condividono il sistema, non variano). Nessun tema di catalogo."
  },
  "fontStack": {
    "display": "Geist (next/font/google)",
