  "framework": "Next.js ^15.5.9 (app router) + Tailwind v4 + React 19",
  "icons": "lucide-react ^1.25.0 (moduli di navigazione via components/layout/moduleIcons.tsx)",
  "preserve": ["token", "font stack", "scala raggi", "stance motion", "logica applicativa"],
