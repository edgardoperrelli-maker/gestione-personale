# Template delle variabili d'ambiente. NON contiene valori veri: copiare in
# `.env.local` (che è in .gitignore) e riempire. Il repo è PUBBLICO, quindi qui
# dentro non va mai una chiave reale.
#
# I valori veri stanno in due posti: le env del progetto su Vercel (fonte di
# verità per produzione) e il backup su Google Drive in `app/Personale/.env.local`,
# tenuto allineato da `salva-env.ps1`.

# --- Obbligatorie: senza queste l'app non parte ---------------------------

# Progetto Supabase «Calendario personale».
NEXT_PUBLIC_SUPABASE_URL="https://aceztqfebringeaebvce.supabase.co"
# Anon key legacy (JWT): dashboard Supabase → Settings → API, oppure env Vercel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key: stessa fonte. BYPASSA LA RLS — mai in git, mai in chat.
# Serve alle API admin; con un placeholder non vuoto la UI gira lo stesso.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Consigliate: senza, alcuni link escono sbagliati ---------------------

# Base per i link assoluti costruiti dalle sincronizzazioni rapportini e dalle
# API mappa. Se vuota, quei link vengono generati monchi. In locale può restare
# l'URL di produzione, così i link condivisi puntano all'app vera.
NEXT_PUBLIC_SITE_URL="https://gestione-personale.vercel.app/"
# Base per i link pubblici generati da `appBaseUrl()` (anteprime Open Graph,
# e-mail). Se assente si ricade su VERCEL_PROJECT_PRODUCTION_URL e poi sul
# dominio di produzione. In dev: http://localhost:3000
NEXT_PUBLIC_BASE_URL=""

# --- Opzionali: senza, la singola funzione resta spenta -------------------

# Segnalazioni «invia segnalazione» → hub ATLAS. La route è fail-closed:
# senza segreto risponde 503 e il pulsante non funziona.
ATLAS_REPORT_SECRET=""
# Override dell'hub ATLAS (per staging). Default: l'hub di produzione.
ATLAS_REPORT_URL=""

# Deriva l'id di sessione dei canali Realtime di assistenza. Se assente si
# ricade su SUPABASE_SERVICE_ROLE_KEY: funziona, ma gli id cambiano se la
# service key viene ruotata, e non coincidono con quelli di produzione se lì
# questa variabile è valorizzata.
ASSIST_CHANNEL_SECRET=""

# Chiave dell'header `x-export-key` per /api/export/limitazioni-massive.
# Se vuota l'endpoint rifiuta sempre.
LIM_MASSIVE_EXPORT_KEY=""

# Invio e-mail (richiesta disponibilità hotel), account Gmail dedicato.
# Porta 465 = TLS implicito, 587 = STARTTLS: entrambe supportate.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Solo per lo script scripts/import-civici-napoli.mjs, che la accetta anche
# come primo argomento da riga di comando.
SOPRALLUOGHI_TERRITORY_ID=""

# --- Impostate da Vercel: non metterle a mano -----------------------------
# VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL, VERCEL_OIDC_TOKEN sono iniettate
# in fase di build/run. `vercel env pull` le scrive anche in locale: il token
# OIDC ha vita breve, se lo trovi scaduto in `.env.local` puoi cancellarlo.
